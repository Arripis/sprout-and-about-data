{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "prHourlyLimit": 1,
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Keep OpenAI on the latest Instructor-compatible major",
      "matchPackageNames": ["openai"],
      "allowedVersions": "<3.0.0"
    },
    {
      "description": "Update Instructor and its OpenAI client as one compatibility-tested unit",
      "matchPackageNames": ["instructor", "openai"],
      "groupName": "Instructor OpenAI stack",
      "groupSlug": "instructor-openai-stack"
    },
    {
      "description": "Automerge every verified dependency update after repository checks pass",
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "pinDigest", "digest", "lockFileMaintenance", "rollback", "bump", "replacement"],
      "addLabels": ["renovate-automerge"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "description": "Mark runtime and LTS-line moves for post-deploy smoke validation and rollback",
      "matchManagers": ["dockerfile", "docker-compose", "github-actions"],
      "matchUpdateTypes": ["major", "replacement"],
      "addLabels": ["renovate-runtime"]
    },
    {
      "description": "Require AI reversibility assessment for stateful datastore line moves",
      "matchPackageNames": ["postgres", "mysql", "mariadb", "mongo", "mongodb", "redis"],
      "matchUpdateTypes": ["major", "replacement"],
      "addLabels": ["renovate-risk-assessment"],
      "automerge": false
    }
  ]
}
