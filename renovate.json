{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Automerge every verified dependency update after repository checks pass",
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "pinDigest", "digest", "lockFileMaintenance", "rollback", "bump", "replacement"],
      "addLabels": ["renovate-automerge"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "description": "Keep only major stateful datastore upgrades behind the critical-change gate",
      "matchPackageNames": ["postgres", "mysql", "mariadb", "mongo", "mongodb", "redis"],
      "matchUpdateTypes": ["major", "replacement"],
      "addLabels": ["renovate-critical"],
      "automerge": false
    }
  ]
}
